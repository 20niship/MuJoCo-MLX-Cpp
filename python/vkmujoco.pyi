"""
Minimal numpy-facing mjmlx bindings for RL training (no mlx.core dependency at the Python boundary)
"""

from typing import Annotated

import numpy
from numpy.typing import NDArray


class Model:
    @property
    def nq(self) -> int: ...

    @property
    def nv(self) -> int: ...

    @property
    def nu(self) -> int: ...

    @property
    def nbody(self) -> int: ...

    @property
    def nsensordata(self) -> int: ...

    def sensors(self) -> list[tuple[str, int, int, int]]: ...

    def name2id(self, arg0: int, arg1: str, /) -> int: ...

    def body_mass(self, arg: int, /) -> float: ...

class BatchedSim:
    @property
    def num_envs(self) -> int: ...

    @property
    def nq(self) -> int: ...

    @property
    def nv(self) -> int: ...

    @property
    def nu(self) -> int: ...

    def step(self, ctrl: Annotated[NDArray[numpy.float32], dict(order='C')], n: int = 1) -> None: ...

    def reset(self, mask: Annotated[NDArray[numpy.int32], dict(order='C')]) -> None: ...

    def set_env_qpos(self, env_idx: int, qpos: Annotated[NDArray[numpy.float32], dict(order='C')]) -> None: ...

    def set_env_qvel(self, env_idx: int, qvel: Annotated[NDArray[numpy.float32], dict(order='C')]) -> None: ...

    def set_state(self, qpos: Annotated[NDArray[numpy.float32], dict(order='C')], qvel: Annotated[NDArray[numpy.float32], dict(order='C')]) -> None: ...

    def set_env_params(self, env_idx: Annotated[NDArray[numpy.int32], dict(order='C')] | None = None, mass_scale: Annotated[NDArray[numpy.float32], dict(order='C')] | None = None, com_delta: Annotated[NDArray[numpy.float32], dict(order='C')] | None = None, friction_scale: Annotated[NDArray[numpy.float32], dict(order='C')] | None = None, gain_scale: Annotated[NDArray[numpy.float32], dict(order='C')] | None = None) -> None: ...

    def set_free_drag(self, env_idx: Annotated[NDArray[numpy.int32], dict(order='C')] | None = None, drag_k: Annotated[NDArray[numpy.float32], dict(order='C')]) -> None: ...

    @property
    def num_free_joints(self) -> int: ...

    def state(self) -> tuple[Annotated[NDArray[numpy.float32], dict(order='C')], Annotated[NDArray[numpy.float32], dict(order='C')]]: ...

    def qpos(self) -> Annotated[NDArray[numpy.float32], dict(order='C')]: ...

    def qvel(self) -> Annotated[NDArray[numpy.float32], dict(order='C')]: ...

    def xpos(self) -> Annotated[NDArray[numpy.float32], dict(order='C')]: ...

    def cfrc_ext(self) -> Annotated[NDArray[numpy.float32], dict(order='C')]: ...

    def sensordata(self) -> Annotated[NDArray[numpy.float32], dict(order='C')]: ...

    def qfrc_actuator(self) -> Annotated[NDArray[numpy.float32], dict(order='C')]: ...

    def set_pack_spec(self, body_ids: Annotated[NDArray[numpy.int32], dict(order='C')], dof_lo: int, ndof: int) -> int: ...

    def read_pack(self) -> Annotated[NDArray[numpy.float32], dict(order='C')]: ...

    def read_pack_into(self, out: Annotated[NDArray[numpy.float32], dict(order='C')]) -> None: ...

class Camera:
    @property
    def num_cameras(self) -> int: ...

    @property
    def width(self) -> int: ...

    @property
    def height(self) -> int: ...

    @property
    def num_envs(self) -> int: ...

    @property
    def draw_calls(self) -> int: ...

    def render(self) -> None: ...

    def rgb(self) -> NDArray[numpy.uint8]: ...

    def depth(self) -> NDArray[numpy.float32]: ...

    @property
    def gpu_supported(self) -> bool: ...

    def gpu_copy(self) -> None: ...

    def gpu_export_fd(self, which: int) -> tuple[int, int]: ...

def create_camera(sim: BatchedSim, width: int, height: int) -> Camera: ...

def load_model(xml_path: str, self_collision: bool = True, max_condim: int = 0) -> Model: ...

def create_batched(model: Model, num_envs: int, frame_skip: int = 1, use_gpu: bool = True, solver_iterations: int = 0, domain_rand: bool = False) -> BatchedSim: ...

def version() -> str: ...
