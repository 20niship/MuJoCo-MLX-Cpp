<!-- Multi-geom scene: exercises all primitive collision types in one model.
     Contains sphere, capsule, box, cylinder, and ellipsoid geoms.
     Used to benchmark collision system throughput across geom types. -->
<mujoco model="multi_geom_scene">
  <option gravity="0 0 -9.81" timestep="0.002"/>

  <worldbody>
    <geom name="floor" type="plane" size="10 10 0.1" rgba="0.3 0.3 0.3 1"/>

    <!-- Spheres -->
    <body name="sphere1" pos="-0.3 -0.3 0.5">
      <freejoint/>
      <geom type="sphere" size="0.08" mass="0.5" rgba="1 0 0 1"/>
    </body>
    <body name="sphere2" pos="0.3 0.3 0.5">
      <freejoint/>
      <geom type="sphere" size="0.06" mass="0.3" rgba="1 0.2 0 1"/>
    </body>
    <body name="sphere3" pos="0 0.5 0.5">
      <freejoint/>
      <geom type="sphere" size="0.1" mass="0.8" rgba="1 0.4 0 1"/>
    </body>

    <!-- Capsules -->
    <body name="capsule1" pos="0.3 -0.3 0.5">
      <freejoint/>
      <geom type="capsule" size="0.05 0.12" mass="0.5" rgba="0 1 0 1"/>
    </body>
    <body name="capsule2" pos="-0.5 0 0.5">
      <freejoint/>
      <geom type="capsule" size="0.06 0.1" mass="0.4" rgba="0 1 0.3 1"/>
    </body>

    <!-- Boxes -->
    <body name="box1" pos="0 0 0.5">
      <freejoint/>
      <geom type="box" size="0.08 0.08 0.08" mass="0.6" rgba="0 0 1 1"/>
    </body>
    <body name="box2" pos="-0.3 0.3 0.8">
      <freejoint/>
      <geom type="box" size="0.06 0.1 0.04" mass="0.4" rgba="0.2 0 1 1"/>
    </body>

    <!-- Cylinders -->
    <body name="cyl1" pos="0.5 0 0.5">
      <freejoint/>
      <geom type="cylinder" size="0.06 0.1" mass="0.5" rgba="1 1 0 1"/>
    </body>
    <body name="cyl2" pos="0 -0.5 0.5">
      <freejoint/>
      <geom type="cylinder" size="0.08 0.08" mass="0.6" rgba="1 1 0.3 1"/>
    </body>

    <!-- Ellipsoids -->
    <body name="ell1" pos="0.3 0 0.8">
      <freejoint/>
      <geom type="ellipsoid" size="0.1 0.06 0.04" mass="0.4" rgba="1 0 1 1"/>
    </body>
    <body name="ell2" pos="-0.3 -0.3 0.8">
      <freejoint/>
      <geom type="ellipsoid" size="0.08 0.08 0.05" mass="0.5" rgba="0.8 0 1 1"/>
    </body>
  </worldbody>
</mujoco>
