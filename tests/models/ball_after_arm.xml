<mujoco model="ball_after_arm">
  <!-- 固定ベースのアームの「後ろ」に別ツリーの自由関節ボールがある(自由関節が先頭でない)。卓球台は solref 直接指定(負値)。 -->
  <option timestep="0.0005" integrator="implicitfast" cone="elliptic" impratio="10"/>
  <worldbody>
    <geom name="table" type="box" size="0.6 0.4 0.02" pos="0.5 0 -0.02" friction="0.25" solref="-1000000 -81.3" priority="1"/>
    <body name="link1" pos="0 0 0.3">
      <joint name="j1" type="hinge" axis="0 0 1" damping="0.05"/>
      <geom type="capsule" fromto="0 0 0 0.1 0 0" size="0.01" mass="0.1"/>
      <body name="link2" pos="0.1 0 0">
        <joint name="j2" type="hinge" axis="0 1 0" damping="0.05"/>
        <geom type="capsule" fromto="0 0 0 0.1 0 0" size="0.01" mass="0.1"/>
      </body>
    </body>
    <body name="ball" pos="0.5 0.2 0.3">
      <freejoint name="ball"/>
      <geom name="ball" type="sphere" size="0.02" mass="0.0027"/>
    </body>
  </worldbody>
  <actuator>
    <position joint="j1" kp="2" kv="0.05"/>
    <position joint="j2" kp="2" kv="0.05"/>
  </actuator>
</mujoco>
