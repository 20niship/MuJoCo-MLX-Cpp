<!-- SDF(torusプラグイン) vs SDF(プラグイン無しのmesh由来SDF=MuJoCoのoctree距離)。mesh由来SDFを格子に焼く経路の検証用 -->
<mujoco>
  <extension>
    <plugin plugin="mujoco.sdf.torus">
      <instance name="torus">
        <config key="radius1" value="0.15"/>
        <config key="radius2" value="0.05"/>
      </instance>
    </plugin>
  </extension>
  <option gravity="0 0 -9.81" timestep="0.002" sdf_iterations="3" sdf_initpoints="10"/>
  <asset>
    <mesh name="torus"><plugin instance="torus"/></mesh>
    <mesh name="cube" vertex="-0.3 -0.3 -0.3  0.3 -0.3 -0.3  0.3 0.3 -0.3  -0.3 0.3 -0.3  -0.3 -0.3 0.3  0.3 -0.3 0.3  0.3 0.3 0.3  -0.3 0.3 0.3"/>
  </asset>
  <worldbody>
    <body><geom type="sdf" mesh="cube" rgba="0 0 1 1"/></body>
    <body pos="0.02 0.01 0.42">
      <freejoint/>
      <geom type="sdf" mesh="torus" rgba=".8 .17 .15 1"><plugin instance="torus"/></geom>
    </body>
  </worldbody>
</mujoco>
