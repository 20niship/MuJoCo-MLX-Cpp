<mujoco model="equality joint (gripper mimic style)">
  <option timestep="0.002" gravity="0 0 0" solver="Newton" iterations="50" tolerance="1e-10"/>
  <worldbody>
    <body name="base">
      <geom type="box" size="0.05 0.05 0.02" mass="1"/>
      <body name="f1" pos="0.05 0 0">
        <joint name="j1" type="slide" axis="1 0 0" range="0 0.04" limited="true" damping="1"/>
        <geom type="box" size="0.01 0.01 0.03" mass="0.1"/>
      </body>
      <body name="f2" pos="-0.05 0 0">
        <joint name="j2" type="slide" axis="1 0 0" range="-0.04 0" limited="true" damping="1"/>
        <geom type="box" size="0.01 0.01 0.03" mass="0.1"/>
      </body>
      <body name="h1" pos="0 0.2 0">
        <joint name="h1" type="hinge" axis="0 0 1" damping="0.1"/>
        <geom type="capsule" fromto="0 0 0 0.1 0 0" size="0.01" mass="0.1"/>
      </body>
      <body name="h2" pos="0 -0.2 0">
        <joint name="h2" type="hinge" axis="0 0 1" damping="0.1"/>
        <geom type="capsule" fromto="0 0 0 0.1 0 0" size="0.01" mass="0.1"/>
      </body>
    </body>
  </worldbody>
  <equality>
    <joint joint1="j2" joint2="j1" polycoef="0 -1 0 0 0" solref="0.005 1" solimp="0.95 0.99 0.001"/>
    <joint joint1="h2" joint2="h1" polycoef="0.1 0.5 0.3 0 0"/>
  </equality>
  <actuator>
    <position joint="j1" kp="200" kv="5"/>
    <position joint="h1" kp="2" kv="0.2"/>
  </actuator>
</mujoco>
