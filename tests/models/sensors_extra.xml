<mujoco model="sensors_extra">
  <option timestep="0.002"/>
  <worldbody>
    <geom name="floor" type="plane" size="10 10 0.1"/>
    <geom name="ball_obs" type="sphere" size="0.2" pos="1.5 0 0.3"/>
    <geom name="box_obs" type="box" size="0.1 0.3 0.2" pos="0 -1.2 0.2"/>
    <geom name="cyl_obs" type="cylinder" size="0.15 0.25" pos="0 1.3 0.25"/>
    <geom name="cap_obs" type="capsule" size="0.1 0.2" pos="-1.4 0 0.3" euler="0 90 0"/>
    <geom name="ell_obs" type="ellipsoid" size="0.3 0.15 0.2" pos="1.0 1.0 0.3"/>
    <site name="target" pos="1.5 0 0.5"/>
    <body name="torso" pos="0 0 0.3">
      <freejoint name="root"/>
      <geom name="torso_g" type="box" size="0.15 0.1 0.05" mass="2" contype="0" conaffinity="0"/>
      <geom name="foot_fl" type="sphere" size="0.04" pos="0.1 0.06 -0.06" mass="0.1"/>
      <geom name="foot_fr" type="sphere" size="0.04" pos="0.1 -0.06 -0.06" mass="0.1"/>
      <geom name="foot_bl" type="sphere" size="0.04" pos="-0.1 0.06 -0.06" mass="0.1"/>
      <geom name="foot_br" type="sphere" size="0.04" pos="-0.1 -0.06 -0.06" mass="0.1"/>
      <site name="rf_down" pos="0 0 -0.05" quat="0 1 0 0"/>
      <site name="rf_fwd" pos="0.15 0 0" quat="0.7071068 0 0.7071068 0"/>
      <site name="rf_right" pos="0 -0.1 0" quat="0.7071068 0.7071068 0 0"/>
      <site name="rf_left" pos="0 0.1 0" quat="0.7071068 -0.7071068 0 0"/>
      <site name="rf_back" pos="-0.15 0 0" quat="0.7071068 0 -0.7071068 0"/>
      <site name="rf_ell" pos="0.15 0.05 0" quat="0.9238795 0 0.3826834 0"/>
      <site name="touch_all" type="box" size="0.25 0.2 0.15" pos="0 0 -0.03"/>
      <site name="touch_foot" type="sphere" size="0.05" pos="0.1 0.06 -0.06"/>
      <site name="touch_cyl" type="cylinder" size="0.07 0.05" pos="0.1 -0.06 -0.06"/>
      <site name="touch_ell" type="ellipsoid" size="0.12 0.1 0.08" pos="-0.05 0 -0.05"/>
      <site name="touch_cap" type="capsule" size="0.06 0.12" pos="0 0.06 -0.06" euler="0 90 0"/>
      <camera name="cam" pos="0.15 0 0.05" xyaxes="0 -1 0 0 0 1" resolution="64 48" fovy="60"/>
      <camera name="cam2" pos="0.1 0.02 0.06" xyaxes="0 -1 0 0 0.1 1" resolution="64 48" sensorsize="0.04 0.03" focal="0.03 0.032" principal="0.002 -0.001"/>
      <body name="arm" pos="0.15 0 0">
        <joint name="shoulder" type="hinge" axis="0 1 0" damping="0.05"/>
        <geom name="arm_g" type="capsule" fromto="0 0 0 0.2 0 0" size="0.02" mass="0.3"/>
        <site name="arm_site" pos="0.1 0 0"/>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="m_shoulder" joint="shoulder" gear="2"/>
  </actuator>
  <sensor>
    <rangefinder name="rf_down" site="rf_down"/>
    <rangefinder name="rf_fwd" site="rf_fwd"/>
    <rangefinder name="rf_right" site="rf_right"/>
    <rangefinder name="rf_left" site="rf_left"/>
    <rangefinder name="rf_back" site="rf_back"/>
    <rangefinder name="rf_ell" site="rf_ell"/>
    <touch name="touch_all" site="touch_all"/>
    <touch name="touch_foot" site="touch_foot"/>
    <touch name="touch_cyl" site="touch_cyl"/>
    <touch name="touch_ell" site="touch_ell"/>
    <touch name="touch_cap" site="touch_cap"/>
    <camprojection name="cam_target" site="target" camera="cam"/>
    <camprojection name="cam_arm" site="arm_site" camera="cam"/>
    <camprojection name="cam2_target" site="target" camera="cam2"/>
    <camprojection name="cam2_arm" site="arm_site" camera="cam2"/>
  </sensor>
</mujoco>
