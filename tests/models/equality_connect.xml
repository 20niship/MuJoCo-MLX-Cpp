<mujoco model="equality connect (closed loop)">
  <option timestep="0.002" solver="Newton" iterations="50" tolerance="1e-10"/>
  <worldbody>
    <body name="a" pos="0 0 1">
      <joint name="ja" type="hinge" axis="0 1 0" damping="0.05"/>
      <geom type="capsule" fromto="0 0 0 0.5 0 0" size="0.02" mass="0.5"/>
      <body name="a2" pos="0.5 0 0">
        <joint name="ja2" type="hinge" axis="0 1 0" damping="0.05"/>
        <geom type="capsule" fromto="0 0 0 0.5 0 0" size="0.02" mass="0.5"/>
      </body>
    </body>
    <body name="b" pos="1 0 1">
      <joint name="jb" type="hinge" axis="0 1 0" damping="0.05"/>
      <geom type="capsule" fromto="0 0 0 -0.5 0 0" size="0.02" mass="0.5"/>
    </body>
  </worldbody>
  <equality>
    <connect body1="a2" body2="b" anchor="0.5 0 0" solref="0.01 1"/>
  </equality>
  <actuator>
    <motor joint="ja" gear="2"/>
  </actuator>
</mujoco>
