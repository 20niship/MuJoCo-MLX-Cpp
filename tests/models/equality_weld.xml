<mujoco model="equality weld">
  <option timestep="0.002" solver="Newton" iterations="50" tolerance="1e-10"/>
  <worldbody>
    <body name="arm" pos="0 0 1">
      <joint name="j1" type="hinge" axis="0 1 0" damping="0.05"/>
      <geom type="capsule" fromto="0 0 0 0.4 0 0" size="0.02" mass="0.5"/>
      <body name="arm2" pos="0.4 0 0">
        <joint name="j2" type="hinge" axis="0 1 0" damping="0.05"/>
        <geom type="capsule" fromto="0 0 0 0.4 0 0" size="0.02" mass="0.5"/>
      </body>
    </body>
    <body name="tip" pos="0.6 0 0.7">
      <joint name="slide_x" type="slide" axis="1 0 0" damping="1"/>
      <joint name="slide_z" type="slide" axis="0 0 1" damping="1"/>
      <joint name="rot_y" type="hinge" axis="0 1 0" damping="0.1"/>
      <geom type="box" size="0.03 0.03 0.03" mass="0.2"/>
    </body>
  </worldbody>
  <equality>
    <weld body1="arm2" body2="tip" relpose="0.4 0 0 1 0 0 0" solref="0.01 1"/>
  </equality>
  <actuator>
    <motor joint="j1" gear="2"/>
  </actuator>
</mujoco>
